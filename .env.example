# Chave da API NVIDIA NIM (gratuita em build.nvidia.com)
NVIDIA_API_KEY=sua_chave_aqui

# Modelos (podem ser alterados conforme disponibilidade no catálogo NIM)
# LLM: nvidia/nemotron-3-super-120b-a12b
# Embeddings: nvidia/nemotron-3-embed-1b (multilíngue)
# Reranker: indisponível no catálogo atual (o app usa fallback sem rerank)
NVIDIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_RERANKER_MODEL=

# Endpoint da API NVIDIA
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Parâmetros de chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Parâmetros de busca
TOP_K=5
SIMILARITY_THRESHOLD=0.35

# Parâmetros do LLM
TEMPERATURE=0
TOP_P=0.1

# Diretórios
UPLOAD_DIR=data/uploads
INDEX_DIR=data/index