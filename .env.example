# Provedor de LLM escolhido: openrouter, nvidia, openai ou ollama
LLM_PROVIDER=ollama


# Modelo local de embeddings (primeira execução baixa o modelo)
# Para usar Ollama nos embeddings, defina EMBEDDING_MODEL=ollama:<modelo> (ex.: ollama:nomic-embed-text)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama (local; não requer chave de API — requer servidor em execução)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

# Chunking e busca
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.45

# Geração
TEMPERATURE=0
TOP_P=0.1

# Diretórios
SEED_DIR=data/seed
UPLOAD_DIR=data/uploads
INDEX_DIR=data/index
