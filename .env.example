SEED_DIR=data/seed
UPLOAD_DIR=data/uploads
INDEX_DIR=data/index

EMBEDDING_MODEL=intfloat/multilingual-e5-small
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
