# Chave da API NVIDIA NIM (gratuita em build.nvidia.com)
NVIDIA_API_KEY=sua_chave_aqui

# Modelos (podem ser alterados conforme disponibilidade no catálogo NIM)
# LLM: nvidia/llama-3.3-nemotron-super-49b-v1 (recomendado para RAG)
# Embeddings: nvidia/nv-embedqa-mistral-7b-v2 (multilíngue)
# Reranker: nvidia/llama-3.2-nv-rerankqa-1b-v2
NVIDIA_LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-mistral-7b-v2
NVIDIA_RERANKER_MODEL=nvidia/llama-3.2-nv-rerankqa-1b-v2

# Endpoint da API NVIDIA
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Parâmetros de chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Parâmetros de busca
TOP_K=5
SIMILARITY_THRESHOLD=0.35

# Parâmetros do LLM
TEMPERATURE=0
TOP_P=0.1

# Diretórios
UPLOAD_DIR=data/uploads
INDEX_DIR=data/index